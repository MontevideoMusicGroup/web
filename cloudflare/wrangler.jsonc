{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "neyra-servicios",
  "main": "../worker.js",
  "compatibility_date": "2025-10-08",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "neyra-db",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "IMAGES",
    "bucket_name": "neyra-images"
  }]
}
