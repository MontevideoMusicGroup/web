{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "neyra-servicios",
  "main": "../worker.js",
  "compatibility_date": "2025-10-08",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "neyra-db",
    "database_id": "c9968770-923c-4ad5-9c3f-86728bc85a79",
    "migrations_dir": "migrations"
  }]
}
